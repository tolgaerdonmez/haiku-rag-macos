# The search service's haiku.rag configuration, rendered by service/build.sh to
# ~/Library/Application Support/haiku.rag/haiku.rag.yaml. Paths use ${HOME} and
# are absolute, so the file also works as a symlink. haiku-ingester writes the
# index; the search service reads it. Embeddings come from the Neural Engine
# embedding server (ane-server/, its own launchd agent), which serves the Core
# ML model in models/jina-nano-coreml on an OpenAI-compatible API.
environment: production
# The indexed folders: one fragment per database in databases.d, written by
# `haiku-rag-macos folders` and the search service. haiku-ingester reloads them.
databases_include: ${HOME}/Library/Application Support/haiku.rag/databases.d
hooks:
  # Deletes a removed folder's documents inside haiku-ingester (haiku-rag-macos).
  - name: macos-folders
    options:
      directory: ${HOME}/Library/Application Support/haiku.rag/databases.d
storage:
  data_dir: ${HOME}/Library/Application Support/haiku.rag
  # Old versions the maintenance vacuum keeps: the search service, a separate
  # process, may still read one for a moment.
  vacuum_retention_seconds: 600
lancedb:
  databases:
    files: ${HOME}/Library/Application Support/haiku.rag/files.lancedb
  read_consistency_interval_seconds: 2   # searches see new documents quickly
embeddings:
  model:
    provider: openai              # the Neural Engine embedding server
    name: jina-embeddings-v5-omni-nano
    base_url: http://127.0.0.1:@EMBED_PORT@/v1   # the server's socket in com.haiku-rag.ane-server.plist.in
    vector_dim: 768
    query_prefix: "Query: "
    document_prefix: "Document: "
processing:
  chunk_size: 1024                # the model's longest function is 2048 tokens
  pictures: none
  conversion_timeout: 300         # a stalled conversion fails; the ingester exits and launchd restarts it
  split_pages: 20                 # large PDFs convert 20 pages at a time
  # An attachment the converter cannot parse fails its PDF (ggozad/haiku.rag#829).
  extract_pdf_attachments: false
  conversion_options:
    ocr_engine: ocrmac            # Apple Vision
    table_mode: fast
    generate_page_images: false
ingester:
  queue:
    path: ${HOME}/Library/Application Support/haiku.rag/ingester.db
  workers:
    worker_count: 4
    poll_idle_interval_s: 5
  api:
    host: 127.0.0.1
    port: @INGESTER_PORT@         # haiku-ingester's own API; the search service talks to it
  maintenance:
    enabled: true                 # vacuum and the vector index once writes go quiet
    quiet_s: 120
